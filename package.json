    "front:dev": "pnpm --filter front dev",
    "front:bui": "pnpm --filter front build",
    "front:pro": "pnpm --filter front start",
    "front:deb": "pnpm --filter front run debug",
    "back:dev": "pnpm --filter back dev",
    "back:bui": "pnpm --filter back build",
    "back:pro": "pnpm --filter back prod",
    "back:deb": "pnpm --filter back debug",
    "all:dev": "concurrently \"pnpm front:dev\" \"pnpm back:dev\"",
    "all:deb": "concurrently \"pnpm front:deb\" \"pnpm back:deb\"",
    "all:pro": "concurrently \"pnpm front:pro\" \"pnpm back:pro\"",
    "all:bui": "pnpm front:bui && pnpm back:bui"
  },
