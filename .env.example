# -----------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (Docker Internal)
# -----------------------------------------------------------------------------
ENV_DBROOT=
ENV_DBPASS=
ENV_DBUSER=
ENV_DBNAME=r2wxdb
ENV_DBHOST=database
ENV_DBURL="mysql://${ENV_DBUSER}:${ENV_DBPASS}@${ENV_DBHOST}:3306/${ENV_DBNAME}"

# -----------------------------------------------------------------------------
# 2. BACKEND (NestJS) CONFIGURATION
# -----------------------------------------------------------------------------


ENV_APPPORT=4000
ENV_PATH_FILES=./uploads
ENV_PATH_FILES_TMP=./uploads
ENV_SERVER_SECRET=


# -----------------------------------------------------------------------------
# 3. FRONTEND (SvelteKit BFF) CONFIGURATION
# -----------------------------------------------------------------------------
# Public App Settings
PUBLIC_BASEPATH=
PUBLIC_APPSERVER=http://localhost:5000


# In Docker, SvelteKit calls the NestJS container by service name:
ENV_DATASERVER=http://backend:4000

# Must match ENV_SERVER_SECRET exactly for the BFF Bearer handshake:
ENV_SECRET="${ENV_SERVER_SECRET}"

# Roles expected by authall.js and httpServer.js
ENV_ROLE_ADMIN=GLOB
ENV_ROLE_READER=READ

